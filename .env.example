# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Everything here is read by src/burn_scar_recovery/config.py, except the GDAL
# variables, which GDAL reads out of the process environment directly.

# ---------------------------------------------------------------------------
# NASA Earthdata Login
# ---------------------------------------------------------------------------
# HLS is behind Earthdata. Register (free) at https://urs.earthdata.nasa.gov
# and then authorise the "LP DAAC Data Pool" application against the account.
#
# Two ways in. Prefer the token: it expires, and it keeps a password out of
# the .netrc that GDAL would otherwise read.
#
# Token: https://urs.earthdata.nasa.gov/profile -> Generate Token
EARTHDATA_TOKEN=

# Or user/password. If you use these, GDAL also wants a ~/.netrc containing:
#   machine urs.earthdata.nasa.gov login <user> password <pass>
# chmod 600 it. .netrc is gitignored.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# HLS lives in AWS us-west-2. Reading from another region adds latency to every
# range request, and latency is what small windowed reads are bound by.
AWS_REGION=us-west-2

CMR_STAC_URL=https://cmr.earthdata.nasa.gov/stac/LPCLOUD

# ---------------------------------------------------------------------------
# GDAL / vsicurl tuning
# ---------------------------------------------------------------------------
# Phase 2 sets and measures these ONE AT A TIME. The values below are the
# defaults you end at, not a starting point to be taken on faith -- the point
# of the phase is the delta each one makes.

# Do not LIST the prefix before opening an object. On object storage a listing
# is a round trip that buys nothing, because the href is already known.
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR

# HTTP/2 multiplexing: many small range requests over one connection instead of
# one connection each. This is the concurrency knee knob.
GDAL_HTTP_MULTIPLEX=YES

# Cache decoded blocks in memory, so overlapping chips within a tile do not
# re-fetch the same COG tile. VSI_CACHE_SIZE is per-file, in bytes.
VSI_CACHE=TRUE
VSI_CACHE_SIZE=536870912

# Only ever attempt these extensions over vsicurl. Stops GDAL probing for
# sidecars (.aux.xml, .ovr, .msk) that do not exist -- each probe is a 404 and
# a round trip.
CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif,.TIF,.tiff

# Global block cache across all open datasets, in MB.
GDAL_CACHEMAX=1024

# The byte counter. rasterio does not expose bytes-over-the-wire, so the
# instrument sums VSICURL range requests out of GDAL's debug log. Leave this
# OFF for production runs -- it is chatty -- and ON when recording a table row.
# CPL_DEBUG=ON
CPL_DEBUG=OFF

# ---------------------------------------------------------------------------
# Local paths
# ---------------------------------------------------------------------------
# The chip cache is an instrument, not a data store: ~10 GB, ~20k chips, on
# NVMe. It exists to answer one question -- how fast does the card go when
# nothing starves it. Never pre-download the corpus here.
DATA_DIR=./data
CACHE_DIR=./cache
RESULTS_DIR=./results

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
BSR_LOG_LEVEL=INFO

# Ray head node address for phase 6, once the M1 Max joins the 5900X box.
# Leave unset for the single-node phases 3-5.
# RAY_ADDRESS=ray://192.168.1.10:10001
